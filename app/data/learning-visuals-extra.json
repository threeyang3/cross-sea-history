  {
    "id": "maritime-policy-comparison",
    "eventIds": [
      "cn-yuegang-opening",
      "cn-qing-sea-opening"
    ],
    "kind": "matrix",
    "title": {
      "zh": "1567年与1684年：两次开海",
      "ja": "1567年と1684年：二つの海禁緩和"
    },
    "subtitle": {
      "zh": "比较政策调整背景、许可方式及仍然存在的边界。",
      "ja": "政策変更の背景・許可の方法・残る制限を比較する。"
    },
    "caution": {
      "zh": "两朝政策并非同一制度直接延续；合法化不等于此前没有交易，也不等于现代自由贸易。",
      "ja": "両王朝の政策が同一制度の直接の継続というわけではない。合法化は以前の交易の不存在や現代の自由貿易を意味しない。"
    },
    "nodes": [
      {
        "id": "ming-background",
        "label": {
          "zh": "市场需求与禁限",
          "ja": "市場需要と海禁"
        },
        "detail": {
          "zh": "明初正式朝贡贸易之外仍有实际商品流通，1567年调整部分民间贸易政策。",
          "ja": "明初の正式な朝貢貿易以外にも商品は流通し、1567年に一部民間交易の政策が変わった。"
        },
        "tone": 0
      },
      {
        "id": "qing-background",
        "label": {
          "zh": "沿海战争之后",
          "ja": "沿海戦争の後"
        },
        "detail": {
          "zh": "清初海禁、迁界与军事对抗有关；1684年调整政策发生在郑氏政权被击败之后。",
          "ja": "清初の海禁・遷界は軍事対抗と関係し、1684年の政策変更は鄭氏政権の敗北後に行われた。"
        },
        "tone": 1
      },
      {
        "id": "ming-permit",
        "label": {
          "zh": "月港许可出洋",
          "ja": "月港からの許可出航"
        },
        "detail": {
          "zh": "福建月港开放民间海外贸易，管理和征税成为重要环节。",
          "ja": "福建の月港で民間海外交易が認められ、管理と徴税が重要な段階となった。"
        },
        "tone": 0
      },
      {
        "id": "qing-permit",
        "label": {
          "zh": "登记与领照",
          "ja": "登録と許可証"
        },
        "detail": {
          "zh": "商民向地方官呈报、登记、保结、领照；船货接受检查并逐步由海关征税。",
          "ja": "商民は地方官への申告・登録・保証・許可証を経て、船貨は検査され海関で課税された。"
        },
        "tone": 1
      },
      {
        "id": "ming-limits",
        "label": {
          "zh": "对日仍受限制",
          "ja": "対日交易の制限"
        },
        "detail": {
          "zh": "部分南海贸易获准，并不代表对日直接渡航贸易限制同时解除。",
          "ja": "南海方面の一部交易の許可は、対日直接渡航の制限解除を意味しない。"
        },
        "tone": 0
      },
      {
        "id": "qing-limits",
        "label": {
          "zh": "查验与禁品",
          "ja": "検査と禁制品"
        },
        "detail": {
          "zh": "开海后仍有查验、违禁货物等规定。",
          "ja": "海禁緩和後も検査・禁制品などの規則が残った。"
        },
        "tone": 1
      }
    ],
